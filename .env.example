# Copy this file to .env at the project root and fill in real values.
# Find these in Supabase Dashboard → your project → Project Settings → API.
#
# IMPORTANT: the URL is the bare project URL (e.g. https://abcd.supabase.co).
# Do NOT include the /rest/v1/ suffix — the Supabase JS client appends it.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — bypasses RLS. Never expose to the client / never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Role launcher (patient app home screen) → sibling apps.
# Keep these commented out to use local dev defaults (driver :8082,
# dispatcher :3001, hospital :3002). Uncomment + set to deployed URLs for a
# hosted demo, or set to an empty string to show that role as "coming soon".
# EXPO_PUBLIC_DRIVER_URL=
# EXPO_PUBLIC_OPERATOR_URL=
# EXPO_PUBLIC_HOSPITAL_URL=
